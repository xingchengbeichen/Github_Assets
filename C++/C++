第一章  搭建C++开发环境
1.1 第一个C++程序
  “Hello World”程序
  包含输入输出函数cout的头文件<iostream>，由于不同的库可能会有重名的部分，所以使用“using namespace std;”加以区分。
“cout << "Hello  World";”会将语句“Hello  World”打印到标准输出cout——一般情况下为操作系统命令行窗口中，“<<”的方向代表了数据的流向。
  一个C++程序只能有一个main函数，但是可以定义其他多个函数。

#include <iostream>
using namespace std;
//Hello World程序

int main(){
  cout << "Hello World";
  return 0;
}


第二章  C++基础语法
2.1 基本内置类型
  C++的基本内置类型有字符型(char)、整型(int)、浮点型(float)和布尔型(bool)。
  不同类型的数据所占存储空间的大小都不尽相同并以位或字节作为基本单位(1字节等于8位)，同时由于操作系统(按种类可分为Unix、Linux、Windows、
MacOS)；按位数(可分为32位和64位)和编译器种类(例如：Visual Studio、Eclipse、CodeBlocks和Xcode等)不同导致C++基本内置类型所占存储空间
的大小无法确定，这时可以通过函数sizeof( )来获得某种数据类型在编译器中具体的大小。通常来说，字符型(char)的最小存储空间为8位、
宽字符型(wchar_t)的最小存储空间为16位、短整型(short)的最小存储空间为16位、整型(int)的最小存储空间为16位、长整型(long int)的最小存储
空间为32位。
  void型一般只用在函数定义中，表示函数没有返回值或者表示通用的指针类型。

#include <iostream>
using namespace std;
//基本数据类型的大小

int main(){
  cout <<"bool的存储空间为"<< sizeof(bool) <<"字节"<< endl;
  cout <<"short的存储空间为"<< sizeof(short) <<"字节"<< endl;
  cout <<"unsigned short的存储空间为"<< sizeof(unsigned short) <<"字节"<< endl;
  cout <<"int的存储空间为"<< sizeof(int) <<"字节"<< endl;
  cout <<"unsigned的存储空间为"<< sizeof(unsigned) <<"字节"<< endl;
  cout <<"long int的存储空间为"<< sizeof(long int) <<"字节"<< endl;
  cout <<"unsigned long int的存储空间为"<< sizeof(unsigned long int) <<"字节"<< endl;
  cout <<"float的存储空间为"<< sizeof(float) <<"字节"<< endl;
  cout <<"double的存储空间为"<< sizeof(double) <<"字节"<< endl;
  cout <<"long double的存储空间为"<< sizeof(long double)<<"字节"<< endl;
  return 0;
}

  整型默认都是有符号的，“int”实际代表“signed int”，“unsigned”可作为“unsigned int”的缩写使用，例如：“unsigned a;”
等价于“unsigned int a;”，即定义无符号整型变量a。
  有符号数可以表示正数和负数，数字的第一位表示符号，0为正1为负。
  16位的有符号短整型short可以表示的最大正整数为32767，而16位的无符号短整型unsigned short可以表示的最大正整数为65535（二进制多一位可
以表示的数就多一倍）。
  超出范围的数值在赋值时会发生溢出，其中低于最小值的叫做下溢(Underflow)，高于最大值的叫做上溢(Overflow)。向下溢出的值会回到最大值，
而向上溢出的值会回到最小值。

#include <iostream>
using namespace std;
//基本数据类型的最大值和最小值

int main(){
  short shortMin=-32768, shortMax=32767;
  unsigned short ushortMin=0, ushortMax=65535;
  int intMin=-2147483648, intMax=2147483647;
  unsigned uintMin=0, uintMax=4294967295;
  cout <<"short的取值范围为"<< shortMin <<"到"<< shortMax << endl;
  cout <<"unsigned short的取值范围为"<< ushortMin <<"到"<< ushortMax << endl;
  cout <<"int的取值范围为"<< intMin <<"到"<< intMax << endl;
  cout <<"unsigned的取值范围为"<< uintMin <<"到"<< uintMax << endl;
  return 0;
}

#include <iostream>
using namespace std;
//超过基本数据类型的最大和最小值会发生溢出

int main(){
  short shortMin=-32769, shortMax=32768;
  unsigned short ushortMin=-1, ushortMax=65536;
  int intMin=-2147483649, intMax=2147483648;
  unsigned uintMin=-1, uintMax=4294967296;
  cout <<"short的下溢值为"<< shortMin <<"，上溢值为"<< shortMax << endl;
  cout <<"unsigned short的下溢值为"<< ushortMin <<"，上溢值为"<< ushortMax << endl;
  cout <<"int的下溢值为"<< intMin <<"，上溢值为"<< intMax << endl;
  cout <<"unsigned的下溢值为"<< uintMin <<"，上溢值为"<< uintMax << endl;
  return 0;
}

  字符型有char和wchar_t两种类型。其本质上就是整型，也可以进行加减乘除的计算和其他各种操作，并且能在前面加上unsigned和signed。
但两者也有以下的区别：
  1.字符型是否有符号取决于编译器；
  2.有效范围内的字符型变量在打印的时候会被解读成字符而不是数字。

#include <iostream>
using namespace std;
//字符型的存储空间和范围

int main(){
  cout <<"char的存储空间为"<< sizeof(char) <<"字节"<< endl;
  cout <<"wchar_t的存储空间为"<< sizeof(wchar_t) <<"字节"<< endl;
  char charMin=-128;
  char charMax=127;
  wchar_t wcharMin=0;
  wchar_t wcharMax=65535;
  cout <<"char的范围为"<< (int)charMin <<"到"<< (int)charMax << endl;
  cout <<"wchar_t的取值范围为"<< (int)wcharMin <<"到"<< (int)wcharMax << endl;
  return 0;
}

#include <iostream>
using namespace std;
//字符型作为数字的运算

int main(){
  char a=2;
  char b=3;
  cout <<"a+b="<< (int)(a+b) << endl;
  cout <<"b-a="<< (int)(b-a) << endl;
  cout <<"a<b："<< (a<b? "true":"false") << endl;
  return 0;
}

#include <iostream>
using namespace std;
//字符的默认符号修饰符

int main(){
  char charMin=-128;
  char charMax=127;
  signed char scharMin=-128;
  signed char scharMax=127;
  unsigned char ucharMin=0;
  unsigned char ucharMax=255;
  cout <<"char的范围为"<< (int)charMin <<"到"<< (int)charMax << endl;
  cout <<"singned char的范围为"<< (int)scharMin <<"到"<< (int)scharMax << endl;
  cout <<"unsigned char的取值范围为"<< (int)ucharMin <<"到"<< (int)ucharMax << endl;
  return 0;
}

