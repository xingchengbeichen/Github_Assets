6.6 函数指针
	函数开始的位置就是函数的地址，也就是函数的入口，而函数值指针指向的就是函数入口。
6.6.1 函数指针的创建与初始化
	基本类型指针与类型名绑定，而与函数指针关联的除了函数的返回值类型（与函数名无关）外，还有函数的所有参数类型和个数。

#include <iostream>
using namespace std;
//函数指针的创建

int min(int a,int b){
	return (a<b)?a:b;
}
int main(){
	int a=4,b=3;
	int (*fpint)(int ,int );                              //函数名和*要加括号，否则编译器会解读成返回值为int*类型的函数
	fpint=min;                                            //函数名代表函数地址，与数组名代表数组首地址一样
	cout <<"a和b中的最小值为："<< fpint(a,b) << endl;
	return 0;
}


#include <iostream>
using namespace std;
//用typedef简化函数指针的定义

int min(int a,int b){
	return (a<b)?a:b;
}
int max=(int a,int b){
	return (a>b)?a:b;
}
int main(){
	int a=5,b=7,x=4,y=3;
	typedef int (*fpint)(int ,int );                 //使用typedef关键字可以避免重复定义函数指针
	fpint fpmax=max;
	fpint fpmin=min;
	cout <<"a和b中的最大值为："<< fpmax(a,b) << endl;
	cout <<"x和y中的最小值为："<< fpmin(x,y) << endl;
	return 0;
}

