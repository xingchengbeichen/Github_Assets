#include <iostream>
using namespace std;
//指针传递

void swap(int *pa,int *pb){
	int temp;
	temp=*pa;
	*pa=*pb;
	*pb=temp;
	cout <<"在swap()函数末尾，a等于"<< *pa <<"，b等于"<< *pb << endl;
}
int main(){
	int a=3,b=4;
	cout <<"交换前a等于"<< a <<"，b等于"<< b << endl;
	swap(&a,&b);
	cout <<"交换后a等于"<< a <<"，b等于"<< b << endl;                 //在main()函数中，变量a和b的值也被交换了
	return 0;
}

