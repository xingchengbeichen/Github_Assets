#include <iostream>
#include <ctype.h>
#include <stdio.h>
using namespace std;
//字符处理函数

int main(){
  char ch=' ';
  cout <<"请输入一些字符，并以'#'结尾："<< endl;
  do{
    ch=getchar();
    cout <<"字符：";
    putchar(ch);
    cout << endl;
    if(isalnum(ch))
      cout <<"输入的是字母或数字！"<< endl;
    if(isalpha(ch)){
      if(isupper(ch)){
        cout <<"输入的是大写字母！"<<endl;
        cout <<"转换成小写字母为：";
        putchar(tolower(ch));
        cout << endl;
      }
      else{
        cout <<"输入的是小写字母！"<< endl;
        cout <<"转换成大写字母为：";
        putchar(toupper(ch));
        cout << endl;
      }
    }
    if(iscntrl(ch))
      cout <<"输入的是控制字符！"<< endl;
    if(isdigit(ch))
      cout <<"输入的是数字！"<< endl;
    if(isgraph(ch))
      cout <<"输入的是可打印字符！"<< endl;
    if(ispunct(ch))
      cout <<"输入的是标点符号！"<< endl;
    if(isspace(ch))
      cout <<"输入的是空白字符！"<< endl;
    if(isxdigit(ch))
      cout <<"输入的是十六进制数！"<< endl;
  }
  while(ch!='#');
  return 0;
}


