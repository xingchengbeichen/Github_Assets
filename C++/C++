2.3 操作符(Operator)
  每个操作符要完成运算所需要的数据，称为操作数(Operand)。
  操作符按照所需操作数个数的不同可分为：一元操作符(Unary Operator)、二元操作符(Ternary Operator)和三元操作符(Ternary Operator)。

#include <iostream>
using namespace std;
//关系操作符、左移和右移操作符

int main(){
  int a=1,b=3;                               //1的二进制数为0001，3的二进制数为0011
  unsigned c=4;                              //4的二进制数为0100
  cout <<"a&b为："<< (a&b) << endl;
  cout <<"a|b为："<< (a|b) << endl;
  cout <<"a^b为："<< (a^b) << endl;
  cout <<"~a为："<< (~2) << endl;
  cout <<"c<<1为："<< (c<<1) << endl;
  cout <<"c>>1为："<< (c>>1) << endl;
  return 0;
}

